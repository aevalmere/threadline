# Copy to .env.local and fill in. .env* is gitignored — never commit real values.
#
# This project uses Supabase's current API key format (sb_publishable_… /
# sb_secret_…), not the legacy eyJ… JWT anon/service_role pair. The variable
# names below keep the old spelling because the code reads them; only the
# values changed. Dashboard → Project Settings → API Keys.

# --- Client (safe to expose; also set these in Cloudflare Pages) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# --- Local only: used by `npm run seed`, never by src/ ---
# The secret key bypasses RLS. NEVER commit it, never put it in Cloudflare
# Pages env vars, never import it from src/.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
SEED_USER_A_EMAIL=alice@example.com
SEED_USER_B_EMAIL=bob@example.com


# --- Offline development (DECISIONS #12) ---
# Runs the whole app against an in-memory backend: no network, no Docker, no
# Supabase project. Proves the interface only — RLS, realtime and constraints
# are NOT exercised, so never judge a backend change by a green mock run.
# Rows persist in localStorage; uploaded files are memory-only and vanish on
# reload. Never set this in Cloudflare Pages.
VITE_MOCK_BACKEND=false
