# Secrets — Non-negotiable 9. Never remove these two lines.
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Supabase CLI local state
supabase/.temp/
supabase/.branches/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Machine-specific junctions/symlinks created by `npx skills add`. The real
# skill content is committed under .agents/skills/; re-run the installer to
# recreate these links on another machine.
.claude/skills/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# graphify (knowledge graph for AI assistants). graph.json, GRAPH_REPORT.md,
# manifest.json and .graphify_analysis.json are committed so teammates start
# with the map; these are regenerated locally by the post-commit hook.
graphify-out/graph.html
graphify-out/cache/
graphify-out/cost.json
graphify-out/.graphify_root
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
